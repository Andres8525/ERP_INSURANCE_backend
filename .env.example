# Copia este archivo a backend/.env y completa los valores. backend/.env está en .gitignore: NUNCA lo subas.
# Spring lo lee automáticamente (spring.config.import en application.yml) al arrancar desde la carpeta backend.
# Sin .env (o sin perfil) la API arranca en modo demo con H2 en memoria.

# --- Perfil -----------------------------------------------------------------
# supabase = PostgreSQL de Supabase (incluye prod: Flyway + validación de esquema)
# prod     = PostgreSQL propio / docker-compose
spring.profiles.active=supabase

SERVER_PORT=8080
# Orígenes del frontend permitidos por CORS, separados por coma (agrega tu dominio de Vercel si despliegas).
FRONTEND_ORIGINS=http://localhost:4200

# --- Base de datos Supabase (Project Settings > Database > Connect > Session pooler) ---
# Formato: jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# En el pooler el usuario es postgres.<project-ref>
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=replace-with-your-database-password
# Esquema propio (no "public", que Supabase expone por su Data API).
DB_SCHEMA=erp
DB_POOL_SIZE=5

# --- Secretos de la aplicación -------------------------------------------------
# 32 bytes aleatorios en Base64. Generar (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# o: openssl rand -base64 32
# IMPORTANTE: con esta clave se cifran los datos personales; si la cambias o la pierdes, no se pueden leer.
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Mínimo 32 caracteres aleatorios. Generar (PowerShell): [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_TTL_MINUTES=60

# --- Datos iniciales ---------------------------------------------------------
# Opción A (presentación): carga usuarios y datos ficticios la primera vez (solo si la base no tiene usuarios).
DEMO_SEED=true
# Opción B (real): crea solo un administrador. Deja DEMO_SEED=false. Contraseña de 16+ caracteres.
# Elimina estas dos líneas después del primer arranque.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
