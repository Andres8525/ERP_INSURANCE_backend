{
  "name": "erp-realtime-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway de tiempo real del ERP médico: short polling, SSE y WebSockets con backplane Redis Pub/Sub",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
